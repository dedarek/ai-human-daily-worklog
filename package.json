{
  "name": "worklog",
  "version": "0.4.0",
  "main": "desktop/main.cjs",
  "desktopName": "worklog.desktop",
  "private": true,
  "license": "Apache-2.0",
  "author": {
    "name": "dedarek",
    "email": "141602590+dedarek@users.noreply.github.com"
  },
  "repository": "https://github.com/dedarek/ai-human-daily-worklog",
  "bugs": "https://github.com/dedarek/ai-human-daily-worklog/issues",
  "description": "Local-first AI work journal for macOS, Windows and Linux.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && node --check public/app.js && node --check public/setup.js && node --check desktop/main.cjs",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke": "npm run build && node scripts/smoke-server.mjs",
    "smoke:credentials": "npm run build && node scripts/smoke-credentials.mjs",
    "doctor": "node scripts/doctor.mjs",
    "build-native": "./scripts/build-native.sh",
    "build-app": "./scripts/build-macos-app.sh",
    "build-dmg": "./scripts/build-dmg.sh",
    "release-dmg": "./scripts/release-dmg.sh",
    "install-service": "./scripts/install-launch-agent.sh",
    "desktop": "npm run build && electron .",
    "build-windows": "npm run build && electron-builder --win nsis --x64 --publish never",
    "build-linux": "npm run build && electron-builder --linux AppImage deb --x64 --publish never"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@larksuite/cli": "1.0.80",
    "express": "^5.1.0",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "build": {
    "appId": "dev.worklog.desktop",
    "productName": "Worklog",
    "asar": true,
    "files": [
      "dist/**/*",
      "public/**/*",
      "desktop/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/@larksuite/cli/bin/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/@larksuite/cli/scripts",
        "to": "lark-cli-runtime/scripts"
      },
      {
        "from": "node_modules/@larksuite/cli/checksums.txt",
        "to": "lark-cli-runtime/checksums.txt"
      },
      {
        "from": "node_modules/@larksuite/cli/package.json",
        "to": "lark-cli-runtime/package.json"
      }
    ],
    "directories": {
      "output": "release/desktop",
      "buildResources": "desktop"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "desktop/icon.png",
      "artifactName": "Worklog-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "desktop/icon.png",
      "category": "Utility",
      "syncDesktopName": true,
      "synopsis": "Local-first AI work journal",
      "artifactName": "Worklog-${version}-Linux-${arch}.${ext}"
    }
  }
}
