{
  "name": "mac-worklog-feishu",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first macOS worklog collector that writes daily, weekly and monthly reports to Feishu through lark-cli.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "doctor": "node scripts/doctor.mjs",
    "build-native": "./scripts/build-native.sh",
    "install-service": "./scripts/install-launch-agent.sh"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "express": "^5.1.0",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
